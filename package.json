{
  "name": "frontend-basics",
  "version": "0.0.1",
  "description": "Cloneable React + Vite frontend template: FSD layers, TanStack Query, Zod-validated API client, Lingui i18n, MSW test setup, Vitest + Stryker, oxlint + oxfmt.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm manifest",
    "manifest": "node scripts/generate-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src tests scripts vite.config.ts vitest.browser.config.ts lingui.config.ts --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix src tests scripts vite.config.ts vitest.browser.config.ts lingui.config.ts",
    "format": "oxfmt \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"!src/locales/**/messages.ts\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"!src/locales/**/messages.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:node": "vitest run --project node",
    "test:jsdom": "vitest run --project jsdom",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf dist coverage reports .stryker-tmp node_modules/.tmp"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "msw": "3.0.7",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-react": "2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=26"
  }
}
