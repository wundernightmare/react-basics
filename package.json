{
  "name": "frontend-basics",
  "version": "0.0.1",
  "description": "Cloneable React + Vite frontend template: FSD layers, TanStack Query, Zod-validated API client, Lingui i18n, MSW test setup, Vitest + Stryker, oxlint + oxfmt.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm manifest",
    "manifest": "node scripts/generate-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsgo -b",
    "lint": "oxlint src tests --quiet",
    "lint:fix": "oxlint --fix src tests",
    "format": "oxfmt \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"!src/locales/**/messages.ts\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"!src/locales/**/messages.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:node": "vitest run --project node",
    "test:jsdom": "vitest run --project jsdom",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf dist coverage reports .stryker-tmp node_modules/.tmp"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router": "8.3.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "6.6.0",
    "@lingui/cli": "6.6.0",
    "@lingui/conf": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/swc-plugin": "6.7.0",
    "@lingui/vite-plugin": "6.6.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "lefthook": "2.1.12",
    "msw": "2.15.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=26"
  }
}
